rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mohanreddy86417@gmail.com' && request.auth.token.email_verified == true)
      );
    }
    function isApprovedSeller() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.approvalStatus == 'Approved';
    }
    function isApprovedDriver() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid))
        && get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data.verificationStatus == 'Approved';
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'mobile', 'role', 'emailVerified', 'phoneVerified', 'onboardingCompleted', 'privacySettings', 'photoUrl', 'defaultPincode', 'suspended', 'suspensionReason', 'referralCode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 160
        && (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 15))
        && data.role in ['customer', 'admin', 'seller', 'delivery']
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('phoneVerified' in data) || data.phoneVerified is bool)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool)
        && (!('privacySettings' in data) || (
          data.privacySettings is map
          && data.privacySettings.keys().hasOnly(['orderUpdatesSms', 'promotionalOffers', 'personalizedRecommendations', 'shareLocationForDelivery'])
          && (!('orderUpdatesSms' in data.privacySettings) || data.privacySettings.orderUpdatesSms is bool)
          && (!('promotionalOffers' in data.privacySettings) || data.privacySettings.promotionalOffers is bool)
          && (!('personalizedRecommendations' in data.privacySettings) || data.privacySettings.personalizedRecommendations is bool)
          && (!('shareLocationForDelivery' in data.privacySettings) || data.privacySettings.shareLocationForDelivery is bool)
        ))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 60000))
        && (!('defaultPincode' in data) || (data.defaultPincode is string && data.defaultPincode.size() <= 6))
        && (!('suspended' in data) || data.suspended is bool)
        && (!('suspensionReason' in data) || (data.suspensionReason is string && data.suspensionReason.size() <= 300))
        && (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 32))
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'displayOrder', 'active'])
        && data.keys().hasOnly(['name', 'slug', 'icon', 'imageUrl', 'description', 'displayOrder', 'active'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 40))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500))
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.displayOrder is number
        && data.active is bool;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['sku', 'name', 'categoryId', 'brand', 'originalPrice', 'sellingPrice', 'stock', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['sku', 'name', 'slug', 'description', 'categoryId', 'categoryName', 'brand', 'images', 'originalPrice', 'sellingPrice', 'discountPercent', 'stock', 'ratingAvg', 'reviewCount', 'soldCount', 'specifications', 'availableSizes', 'availableColors', 'sellerId', 'sellerName', 'cityId', 'serviceZones', 'approvalStatus', 'tags', 'taxRatePercent', 'active', 'lastOrderId', 'createdAt', 'updatedAt'])
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 60
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && (!('slug' in data) || (data.slug is string && data.slug.size() <= 200))
        && (!('description' in data) || (data.description is string && data.description.size() <= 4000))
        && data.categoryId is string && data.categoryId.size() <= 128
        && (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 80))
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 80
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 8 && data.images[0] is string
        && data.originalPrice is number && data.originalPrice >= 0
        && data.sellingPrice is number && data.sellingPrice >= 0 && data.sellingPrice <= data.originalPrice
        && (!('discountPercent' in data) || (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 99))
        && data.stock is number && data.stock >= 0
        && (!('ratingAvg' in data) || (data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5))
        && (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0))
        && (!('soldCount' in data) || (data.soldCount is number && data.soldCount >= 0))
        && (!('specifications' in data) || data.specifications is map)
        && (!('availableSizes' in data) || (data.availableSizes is list && data.availableSizes.size() <= 20))
        && (!('availableColors' in data) || (data.availableColors is list && data.availableColors.size() <= 20))
        && (!('sellerId' in data) || (data.sellerId is string && data.sellerId.size() <= 128))
        && (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 120))
        && (!('cityId' in data) || (data.cityId is string && data.cityId.size() <= 64))
        && (!('serviceZones' in data) || (data.serviceZones is list && data.serviceZones.size() <= 25))
        && (!('approvalStatus' in data) || data.approvalStatus in ['Approved', 'Pending', 'Rejected'])
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
        && (!('taxRatePercent' in data) || (data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 40))
        && data.active is bool
        && (!('lastOrderId' in data) || isValidId(data.lastOrderId))
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidCart(data) {
      return data.keys().hasAll(['items', 'updatedAt'])
        && data.keys().hasOnly(['items', 'updatedAt'])
        && data.items is list && data.items.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['productIds', 'updatedAt'])
        && data.keys().hasOnly(['productIds', 'updatedAt'])
        && data.productIds is list && data.productIds.size() <= 100
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidAddress(data) {
      return data.keys().hasAll(['userId', 'label', 'fullName', 'mobile', 'houseNo', 'street', 'locality', 'city', 'district', 'state', 'pincode', 'isDefault', 'createdAt'])
        && data.keys().hasOnly(['userId', 'label', 'fullName', 'mobile', 'altMobile', 'houseNo', 'street', 'locality', 'landmark', 'city', 'district', 'state', 'pincode', 'lat', 'lng', 'placeId', 'formattedAddress', 'zoneId', 'wardNumber', 'isDefault', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.label in ['Home', 'Work', 'Other']
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100
        && data.mobile is string && data.mobile.matches('^[6-9][0-9]{9}$')
        && (!('altMobile' in data) || (data.altMobile is string && data.altMobile.size() <= 10))
        && data.houseNo is string && data.houseNo.size() >= 1 && data.houseNo.size() <= 100
        && data.street is string && data.street.size() >= 1 && data.street.size() <= 150
        && data.locality is string && data.locality.size() >= 1 && data.locality.size() <= 150
        && (!('landmark' in data) || (data.landmark is string && data.landmark.size() <= 150))
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 100
        && data.district is string && data.district.size() >= 1 && data.district.size() <= 100
        && data.state is string && data.state.size() >= 1 && data.state.size() <= 100
        && data.pincode is string && data.pincode.matches('^[1-9][0-9]{5}$')
        && (!('lat' in data) || (data.lat is number && data.lat >= -90 && data.lat <= 90))
        && (!('lng' in data) || (data.lng is number && data.lng >= -180 && data.lng <= 180))
        && (!('placeId' in data) || (data.placeId is string && data.placeId.size() <= 200))
        && (!('formattedAddress' in data) || (data.formattedAddress is string && data.formattedAddress.size() <= 400))
        && (!('zoneId' in data) || (data.zoneId is string && data.zoneId.size() <= 64))
        && (!('wardNumber' in data) || (data.wardNumber is number && data.wardNumber >= 1 && data.wardNumber <= 500))
        && data.isDefault is bool
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'type', 'value', 'minOrderAmount', 'maxDiscount', 'expiryDate', 'usageLimit', 'usedCount', 'active'])
        && data.keys().hasOnly(['code', 'type', 'value', 'minOrderAmount', 'maxDiscount', 'expiryDate', 'usageLimit', 'usedCount', 'active'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 30
        && data.type in ['PERCENT', 'FIXED']
        && data.value is number && data.value > 0
        && data.minOrderAmount is number && data.minOrderAmount >= 0
        && data.maxDiscount is number && data.maxDiscount >= 0
        && data.expiryDate is string && data.expiryDate.size() <= 40
        && data.usageLimit is number && data.usageLimit >= 1
        && data.usedCount is number && data.usedCount >= 0
        && data.active is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'userId', 'idempotencyKey', 'customerInfo', 'deliveryAddress', 'deliveryOption', 'pricing', 'paymentMethod', 'paymentStatus', 'orderStatus', 'statusHistory', 'itemsCount', 'itemsPreview', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderNumber', 'userId', 'idempotencyKey', 'customerInfo', 'deliveryAddress', 'serviceAreaMeta', 'courierTracking', 'deliveryOption', 'estimatedDeliveryText', 'pricing', 'paymentMethod', 'paymentStatus', 'refundStatus', 'refundAmount', 'refundNotes', 'razorpayOrderId', 'razorpayPaymentId', 'orderStatus', 'returnRequest', 'sellerIds', 'assignedDriverId', 'deliveryAssignmentId', 'statusHistory', 'itemsCount', 'itemsPreview', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 5 && data.orderNumber.size() <= 40
        && isValidId(data.userId)
        && data.idempotencyKey is string && data.idempotencyKey.size() >= 8 && data.idempotencyKey.size() <= 128
        && data.customerInfo is map
        && data.deliveryAddress is map
        && (!('serviceAreaMeta' in data) || data.serviceAreaMeta is map)
        && (!('courierTracking' in data) || data.courierTracking is map)
        && data.deliveryOption in ['STANDARD', 'EXPRESS']
        && (!('estimatedDeliveryText' in data) || (data.estimatedDeliveryText is string && data.estimatedDeliveryText.size() <= 150))
        && data.pricing is map && data.pricing.finalAmount is number && data.pricing.finalAmount >= 0
        && data.paymentMethod in ['COD', 'UPI', 'CARD', 'NETBANKING', 'WALLET']
        && data.paymentStatus in ['Pending', 'Initiated', 'Paid', 'Failed', 'Cancelled', 'Refunded']
        && (!('refundStatus' in data) || data.refundStatus in ['None', 'Initiated', 'Processed', 'Failed'])
        && (!('refundAmount' in data) || (data.refundAmount is number && data.refundAmount >= 0))
        && (!('refundNotes' in data) || (data.refundNotes is string && data.refundNotes.size() <= 300))
        && (!('razorpayOrderId' in data) || (data.razorpayOrderId is string && data.razorpayOrderId.size() <= 120))
        && (!('razorpayPaymentId' in data) || (data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 120))
        && data.orderStatus in ['Order Placed', 'Confirmed', 'Accepted', 'Processing', 'Preparing', 'Packed', 'Ready for Pickup', 'Shipped', 'Out for Delivery', 'Delivered', 'Cancelled', 'Return Requested', 'Returned']
        && (!('returnRequest' in data) || (data.returnRequest is map && data.returnRequest.reason is string && data.returnRequest.reason.size() <= 200))
        && (!('sellerIds' in data) || (data.sellerIds is list && data.sellerIds.size() <= 25))
        && (!('assignedDriverId' in data) || (data.assignedDriverId is string && data.assignedDriverId.size() <= 128))
        && (!('deliveryAssignmentId' in data) || (data.deliveryAssignmentId is string && data.deliveryAssignmentId.size() <= 128))
        && data.statusHistory is list && data.statusHistory.size() >= 1 && data.statusHistory.size() <= 30
        && data.itemsCount is number && data.itemsCount >= 1
        && data.itemsPreview is list && data.itemsPreview.size() >= 1 && data.itemsPreview.size() <= 50
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidOrderItem(data) {
      return data.keys().hasAll(['orderId', 'userId', 'productId', 'name', 'unitSellingPrice', 'quantity', 'lineTotal', 'createdAt'])
        && data.keys().hasOnly(['orderId', 'userId', 'productId', 'sku', 'name', 'image', 'unitOriginalPrice', 'unitSellingPrice', 'quantity', 'lineTotal', 'taxAmount', 'selectedSize', 'selectedColor', 'sellerId', 'sellerName', 'createdAt'])
        && isValidId(data.orderId)
        && isValidId(data.userId)
        && isValidId(data.productId)
        && (!('sku' in data) || (data.sku is string && data.sku.size() <= 60))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && (!('image' in data) || (data.image is string && data.image.size() <= 500))
        && (!('unitOriginalPrice' in data) || (data.unitOriginalPrice is number && data.unitOriginalPrice >= 0))
        && data.unitSellingPrice is number && data.unitSellingPrice >= 0
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 50
        && data.lineTotal is number && data.lineTotal >= 0
        && (!('taxAmount' in data) || (data.taxAmount is number && data.taxAmount >= 0))
        && (!('selectedSize' in data) || (data.selectedSize is string && data.selectedSize.size() <= 40))
        && (!('selectedColor' in data) || (data.selectedColor is string && data.selectedColor.size() <= 40))
        && (!('sellerId' in data) || (data.sellerId is string && data.sellerId.size() <= 128))
        && (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 120))
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['orderId', 'orderNumber', 'userId', 'method', 'amount', 'currency', 'status', 'createdAt'])
        && data.keys().hasOnly(['orderId', 'orderNumber', 'idempotencyKey', 'userId', 'customerName', 'customerEmail', 'method', 'razorpayOrderId', 'razorpayPaymentId', 'razorpayRefundId', 'gatewayVerified', 'failureReason', 'amount', 'currency', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.orderId)
        && data.orderNumber is string && data.orderNumber.size() <= 40
        && (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 128))
        && isValidId(data.userId)
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100))
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 160))
        && data.method in ['COD', 'UPI', 'CARD', 'NETBANKING', 'WALLET']
        && (!('razorpayOrderId' in data) || (data.razorpayOrderId is string && data.razorpayOrderId.size() <= 120))
        && (!('razorpayPaymentId' in data) || (data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 120))
        && (!('razorpayRefundId' in data) || (data.razorpayRefundId is string && data.razorpayRefundId.size() <= 120))
        && (!('gatewayVerified' in data) || data.gatewayVerified is bool)
        && (!('failureReason' in data) || (data.failureReason is string && data.failureReason.size() <= 300))
        && data.amount is number && data.amount >= 0
        && data.currency is string && data.currency.size() <= 10
        && data.status in ['Pending', 'Initiated', 'Paid', 'Failed', 'Cancelled', 'Refunded']
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'rating', 'title', 'comment', 'verifiedPurchase', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'productId', 'sellerId', 'userId', 'userName', 'rating', 'title', 'comment', 'images', 'verifiedPurchase', 'sellerReply', 'sellerReplyBy', 'sellerRepliedAt', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 260
        && isValidId(data.productId)
        && (!('sellerId' in data) || (data.sellerId is string && data.sellerId.size() <= 128))
        && isValidId(data.userId)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000
        && (!('images' in data) || (data.images is list && data.images.size() <= 4))
        && data.verifiedPurchase is bool
        && (!('sellerReply' in data) || (data.sellerReply is string && data.sellerReply.size() <= 800))
        && (!('sellerReplyBy' in data) || (data.sellerReplyBy is string && data.sellerReplyBy.size() <= 120))
        && (!('sellerRepliedAt' in data) || (data.sellerRepliedAt is string && data.sellerRepliedAt.size() <= 40))
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['userId', 'title', 'message', 'orderId', 'read', 'createdAt'])
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && (!('orderId' in data) || data.orderId == null || (data.orderId is string && data.orderId.size() <= 128))
        && data.read is bool
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['userId', 'name', 'email', 'topic', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['userId', 'userRole', 'name', 'email', 'orderNumber', 'topic', 'message', 'status', 'adminReply', 'repliedBy', 'updatedAt', 'createdAt'])
        && isValidId(data.userId)
        && (!('userRole' in data) || data.userRole in ['customer', 'seller', 'delivery'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 40))
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 80
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
        && data.status in ['Open', 'In Progress', 'Resolved']
        && (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 1500))
        && (!('repliedBy' in data) || (data.repliedBy is string && data.repliedBy.size() <= 160))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40))
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidFlashSale(data) {
      return data.keys().hasAll(['title', 'productId', 'productName', 'originalPrice', 'salePrice', 'discountPercent', 'saleStock', 'soldCount', 'startDate', 'endDate', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'productId', 'productName', 'productImage', 'brand', 'categoryName', 'originalPrice', 'salePrice', 'discountPercent', 'saleStock', 'soldCount', 'startDate', 'endDate', 'active', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 180
        && (!('productImage' in data) || (data.productImage is string && data.productImage.size() <= 500))
        && (!('brand' in data) || (data.brand is string && data.brand.size() <= 80))
        && (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 80))
        && data.originalPrice is number && data.originalPrice > 0
        && data.salePrice is number && data.salePrice > 0 && data.salePrice <= data.originalPrice
        && data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 95
        && data.saleStock is number && data.saleStock >= 0
        && data.soldCount is number && data.soldCount >= 0
        && data.startDate is string && data.startDate.size() <= 40
        && data.endDate is string && data.endDate.size() <= 40
        && data.active is bool
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidRewardAccount(data) {
      return data.keys().hasAll(['userId', 'pointsBalance', 'totalEarned', 'totalRedeemed', 'referralCode', 'history', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'pointsBalance', 'totalEarned', 'totalRedeemed', 'referralCode', 'history', 'updatedAt'])
        && isValidId(data.userId)
        && data.pointsBalance is number && data.pointsBalance >= 0
        && data.totalEarned is number && data.totalEarned >= 0
        && data.totalRedeemed is number && data.totalRedeemed >= 0
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32
        && data.history is list && data.history.size() <= 100
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['earnPointsPer100', 'rupeePerPoint', 'maxRedeemPercent', 'referralBonusPoints', 'defaultSellerCommissionPercent', 'updatedAt'])
        && data.keys().hasOnly(['id', 'earnPointsPer100', 'rupeePerPoint', 'maxRedeemPercent', 'referralBonusPoints', 'defaultSellerCommissionPercent', 'promoBannerText', 'promoBannerActive', 'updatedAt'])
        && data.earnPointsPer100 is number && data.earnPointsPer100 >= 0 && data.earnPointsPer100 <= 50
        && data.rupeePerPoint is number && data.rupeePerPoint > 0 && data.rupeePerPoint <= 10
        && data.maxRedeemPercent is number && data.maxRedeemPercent >= 0 && data.maxRedeemPercent <= 50
        && data.referralBonusPoints is number && data.referralBonusPoints >= 0 && data.referralBonusPoints <= 5000
        && data.defaultSellerCommissionPercent is number && data.defaultSellerCommissionPercent >= 0 && data.defaultSellerCommissionPercent <= 50
        && (!('promoBannerText' in data) || (data.promoBannerText is string && data.promoBannerText.size() <= 240))
        && (!('promoBannerActive' in data) || data.promoBannerActive is bool)
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt'])
        && isValidId(data.actorUid)
        && data.actorEmail is string && data.actorEmail.size() <= 160
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 60
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 400
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidSeller(data) {
      return data.keys().hasAll(['sellerId', 'userId', 'businessName', 'ownerName', 'email', 'mobile', 'pickupAddress', 'commissionPercent', 'approvalStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['sellerId', 'userId', 'businessName', 'ownerName', 'email', 'mobile', 'shopCategory', 'shopPhone', 'description', 'logoUrl', 'coverImageUrl', 'verificationDocs', 'gstin', 'cityId', 'serviceZones', 'wardNumbers', 'operatingHours', 'pickupAddress', 'payoutUpiOrBank', 'commissionPercent', 'approvalStatus', 'rejectionReason', 'reviewedAt', 'reviewedBy', 'totalGrossSales', 'totalCommissionPaid', 'totalNetEarnings', 'createdAt', 'updatedAt'])
        && isValidId(data.sellerId)
        && isValidId(data.userId)
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 120
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 100
        && data.email is string && data.email.size() <= 160
        && data.mobile is string && data.mobile.matches('^[6-9][0-9]{9}$')
        && (!('shopCategory' in data) || (data.shopCategory is string && data.shopCategory.size() <= 80))
        && (!('shopPhone' in data) || (data.shopPhone is string && data.shopPhone.size() <= 15))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1500))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 60000))
        && (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 60000))
        && (!('verificationDocs' in data) || (data.verificationDocs is list && data.verificationDocs.size() <= 8))
        && (!('gstin' in data) || (data.gstin is string && data.gstin.size() <= 30))
        && (!('cityId' in data) || (data.cityId is string && data.cityId.size() <= 64))
        && (!('serviceZones' in data) || (data.serviceZones is list && data.serviceZones.size() <= 25))
        && (!('wardNumbers' in data) || (data.wardNumbers is list && data.wardNumbers.size() <= 100))
        && (!('operatingHours' in data) || data.operatingHours is map)
        && data.pickupAddress is map
        && (!('payoutUpiOrBank' in data) || (data.payoutUpiOrBank is string && data.payoutUpiOrBank.size() <= 120))
        && data.commissionPercent is number && data.commissionPercent >= 0 && data.commissionPercent <= 50
        && data.approvalStatus in ['Pending', 'Under Review', 'Approved', 'Rejected', 'Suspended']
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 300))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidSellerSettlement(data) {
      return data.keys().hasAll(['id', 'sellerId', 'sellerName', 'orderId', 'orderNumber', 'grossAmount', 'commissionPercent', 'commissionAmount', 'netPayoutAmount', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'sellerId', 'sellerName', 'orderId', 'orderNumber', 'grossAmount', 'commissionPercent', 'commissionAmount', 'netPayoutAmount', 'status', 'payoutReference', 'deductionReason', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.sellerId)
        && isValidId(data.orderId)
        && data.grossAmount is number && data.grossAmount >= 0
        && data.commissionPercent is number && data.commissionPercent >= 0 && data.commissionPercent <= 50
        && data.commissionAmount is number && data.commissionAmount >= 0
        && data.netPayoutAmount is number && data.netPayoutAmount >= 0
        && data.status in ['Pending', 'Paid', 'Cancelled']
        && (!('deductionReason' in data) || (data.deductionReason is string && data.deductionReason.size() <= 240))
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidDeliveryPartner(data) {
      return data.keys().hasAll(['partnerId', 'userId', 'fullName', 'mobile', 'email', 'vehicleType', 'vehicleNumber', 'licenseNumber', 'city', 'state', 'verificationStatus', 'isOnline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['partnerId', 'userId', 'fullName', 'mobile', 'email', 'vehicleType', 'vehicleNumber', 'licenseNumber', 'cityId', 'city', 'state', 'assignedZones', 'verificationStatus', 'isOnline', 'currentLat', 'currentLng', 'locationUpdatedAt', 'totalDeliveries', 'totalEarnings', 'createdAt', 'updatedAt'])
        && isValidId(data.partnerId)
        && isValidId(data.userId)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.mobile is string && data.mobile.matches('^[6-9][0-9]{9}$')
        && data.email is string && data.email.size() <= 160
        && data.vehicleType in ['Bike', 'Scooter', 'Cycle', 'Van']
        && data.vehicleNumber is string && data.vehicleNumber.size() >= 2 && data.vehicleNumber.size() <= 30
        && data.licenseNumber is string && data.licenseNumber.size() >= 4 && data.licenseNumber.size() <= 40
        && (!('cityId' in data) || (data.cityId is string && data.cityId.size() <= 64))
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.state is string && data.state.size() >= 1 && data.state.size() <= 80
        && (!('assignedZones' in data) || (data.assignedZones is list && data.assignedZones.size() <= 25))
        && data.verificationStatus in ['Pending', 'Approved', 'Suspended']
        && data.isOnline is bool
        && (!('currentLat' in data) || (data.currentLat is number && data.currentLat >= -90 && data.currentLat <= 90))
        && (!('currentLng' in data) || (data.currentLng is number && data.currentLng >= -180 && data.currentLng <= 180))
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidDeliveryAssignment(data) {
      return data.keys().hasAll(['id', 'orderId', 'orderNumber', 'userId', 'driverId', 'driverName', 'driverMobile', 'pickupSummary', 'customerName', 'customerMobile', 'deliverySummary', 'codAmountToCollect', 'deliveryFeeEarning', 'status', 'otpHash', 'assignedAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderId', 'orderNumber', 'userId', 'driverId', 'driverName', 'driverMobile', 'zoneId', 'zoneName', 'pickupSummary', 'customerName', 'customerMobile', 'deliverySummary', 'deliveryLat', 'deliveryLng', 'codAmountToCollect', 'deliveryFeeEarning', 'status', 'otpHash', 'otpSubmittedHash', 'driverLat', 'driverLng', 'driverLocationUpdatedAt', 'assignedAt', 'deliveredAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.orderId)
        && isValidId(data.userId)
        && isValidId(data.driverId)
        && (!('zoneId' in data) || (data.zoneId is string && data.zoneId.size() <= 64))
        && (!('zoneName' in data) || (data.zoneName is string && data.zoneName.size() <= 120))
        && data.status in ['Assigned', 'Accepted', 'Rejected', 'Picked Up', 'Out for Delivery', 'Delivered']
        && data.otpHash is string && data.otpHash.size() >= 32 && data.otpHash.size() <= 128
        && (!('driverLat' in data) || (data.driverLat is number && data.driverLat >= -90 && data.driverLat <= 90))
        && (!('driverLng' in data) || (data.driverLng is number && data.driverLng >= -180 && data.driverLng <= 180))
        && (!('driverLocationUpdatedAt' in data) || (data.driverLocationUpdatedAt is string && data.driverLocationUpdatedAt.size() <= 40))
        && (!('deliveredAt' in data) || (data.deliveredAt is string && data.deliveredAt.size() <= 40))
        && data.assignedAt is string && data.assignedAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidServiceCity(data) {
      return data.keys().hasAll(['id', 'name', 'state', 'country', 'currency', 'hubName', 'hubLocality', 'hubPincode', 'hubLat', 'hubLng', 'active', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'state', 'country', 'currency', 'hubName', 'hubLocality', 'hubAddress', 'hubPincode', 'hubLat', 'hubLng', 'boundarySource', 'boundaryGeoJson', 'totalWardsConfigured', 'defaultDeliveryCharge', 'freeDeliveryThreshold', 'defaultMinOrderAmount', 'active', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.state is string && data.state.size() >= 1 && data.state.size() <= 100
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 60
        && data.currency == 'INR'
        && data.hubName is string && data.hubName.size() >= 1 && data.hubName.size() <= 160
        && data.hubLocality is string && data.hubLocality.size() >= 1 && data.hubLocality.size() <= 120
        && data.hubPincode is string && data.hubPincode.matches('^[1-9][0-9]{5}$')
        && data.hubLat is number && data.hubLat >= -90 && data.hubLat <= 90
        && data.hubLng is number && data.hubLng >= -180 && data.hubLng <= 180
        && (!('boundaryGeoJson' in data) || (data.boundaryGeoJson is string && data.boundaryGeoJson.size() <= 300000))
        && data.active is bool
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidServiceZone(data) {
      return data.keys().hasAll(['id', 'cityId', 'name', 'shortCode', 'localities', 'pincodes', 'deliveryCharge', 'minOrderAmount', 'freeDeliveryThreshold', 'enabled', 'updatedAt'])
        && data.keys().hasOnly(['id', 'cityId', 'name', 'shortCode', 'description', 'localities', 'unverifiedLocalities', 'pincodes', 'wardNumbers', 'boundaryVerified', 'allowOutsideMunicipalBoundary', 'centerLat', 'centerLng', 'deliveryCharge', 'minOrderAmount', 'freeDeliveryThreshold', 'estimatedDeliveryText', 'enabled', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.cityId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.shortCode is string && data.shortCode.size() >= 1 && data.shortCode.size() <= 24
        && data.localities is list && data.localities.size() <= 80
        && (!('unverifiedLocalities' in data) || (data.unverifiedLocalities is list && data.unverifiedLocalities.size() <= 50))
        && data.pincodes is list && data.pincodes.size() <= 50
        && data.deliveryCharge is number && data.deliveryCharge >= 0 && data.deliveryCharge <= 2000
        && data.minOrderAmount is number && data.minOrderAmount >= 0 && data.minOrderAmount <= 50000
        && data.freeDeliveryThreshold is number && data.freeDeliveryThreshold >= 0
        && data.enabled is bool
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidServiceWard(data) {
      return data.keys().hasAll(['id', 'cityId', 'wardNumber', 'wardName', 'zoneId', 'boundaryStatus', 'enabled', 'updatedAt'])
        && data.keys().hasOnly(['id', 'cityId', 'wardNumber', 'wardName', 'zoneId', 'localities', 'pincodes', 'boundaryStatus', 'geoJsonPolygon', 'enabled', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.cityId)
        && data.wardNumber is number && data.wardNumber >= 1 && data.wardNumber <= 500
        && data.wardName is string && data.wardName.size() >= 1 && data.wardName.size() <= 140
        && isValidId(data.zoneId)
        && data.boundaryStatus in ['Verified VMC', 'Official Ward Polygon Verified', 'Locality Mapped', 'Delimitation Pending Polygon', 'Outside VMC']
        && (!('geoJsonPolygon' in data) || (data.geoJsonPolygon is string && data.geoJsonPolygon.size() <= 150000))
        && data.enabled is bool
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidPublicShop(data) {
      return data.keys().hasAll(['shopId', 'shopName', 'cityId', 'locality', 'pincode', 'serviceZones', 'operatingHours', 'approvalStatus', 'updatedAt'])
        && data.keys().hasOnly(['shopId', 'shopName', 'shopCategory', 'shopPhone', 'description', 'logoUrl', 'coverImageUrl', 'cityId', 'locality', 'addressText', 'pincode', 'lat', 'lng', 'serviceZones', 'wardNumbers', 'operatingHours', 'approvalStatus', 'isHub', 'updatedAt'])
        && isValidId(data.shopId)
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 140
        && (!('shopCategory' in data) || (data.shopCategory is string && data.shopCategory.size() <= 80))
        && (!('shopPhone' in data) || (data.shopPhone is string && data.shopPhone.size() <= 15))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1500))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 60000))
        && (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 60000))
        && isValidId(data.cityId)
        && data.locality is string && data.locality.size() >= 1 && data.locality.size() <= 140
        && data.pincode is string && data.pincode.matches('^[1-9][0-9]{5}$')
        && data.serviceZones is list && data.serviceZones.size() <= 25
        && data.operatingHours is map
        && data.approvalStatus in ['Pending', 'Under Review', 'Approved', 'Rejected', 'Suspended']
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidPublicDriver(data) {
      return data.keys().hasAll(['partnerId', 'cityId', 'assignedZones', 'isOnline', 'verificationStatus', 'updatedAt'])
        && data.keys().hasOnly(['partnerId', 'cityId', 'assignedZones', 'isOnline', 'verificationStatus', 'currentLat', 'currentLng', 'updatedAt'])
        && isValidId(data.partnerId)
        && isValidId(data.cityId)
        && data.assignedZones is list && data.assignedZones.size() <= 25
        && data.isOnline is bool
        && data.verificationStatus in ['Pending', 'Approved', 'Suspended']
        && (!('currentLat' in data) || (data.currentLat is number && data.currentLat >= -90 && data.currentLat <= 90))
        && (!('currentLng' in data) || (data.currentLng is number && data.currentLng >= -180 && data.currentLng <= 180))
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    // Collection Rules
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(uid);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role in ['customer', 'seller']
        && (!('suspended' in incoming()) || incoming().suspended == false);
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().role == existing().role
          && (!('suspended' in incoming()) || incoming().suspended == existing().get('suspended', false))
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'mobile', 'photoUrl', 'defaultPincode', 'emailVerified', 'phoneVerified', 'onboardingCompleted', 'privacySettings', 'referralCode', 'updatedAt']))
      );
      allow delete: if isValidId(userId) && (isAdmin() || isOwner(userId));
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId) && isValidProduct(incoming()) && (
        isAdmin() ||
        (isApprovedSeller() && incoming().sellerId == request.auth.uid)
      );
      allow update: if isValidId(productId) && isValidProduct(incoming()) && (
        isAdmin() ||
        (isApprovedSeller()
          && existing().sellerId == request.auth.uid
          && incoming().sellerId == existing().sellerId
          && incoming().createdAt == existing().createdAt
          && incoming().get('ratingAvg', 0) == existing().get('ratingAvg', 0)
          && incoming().get('reviewCount', 0) == existing().get('reviewCount', 0)
          && incoming().get('soldCount', 0) == existing().get('soldCount', 0)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'sku', 'name', 'slug', 'description', 'categoryId', 'categoryName', 'brand',
            'images', 'originalPrice', 'sellingPrice', 'discountPercent', 'stock',
            'specifications', 'availableSizes', 'availableColors', 'sellerName', 'cityId',
            'serviceZones', 'tags', 'taxRatePercent', 'active', 'updatedAt'
          ])) ||
        (isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'soldCount', 'lastOrderId', 'updatedAt'])
          && incoming().stock >= 0
          && incoming().stock < existing().stock
          && incoming().soldCount >= existing().soldCount
          && incoming().soldCount <= existing().soldCount + 50
          && ('lastOrderId' in incoming())
          && isValidId(incoming().lastOrderId)
          && !exists(/databases/$(database)/documents/orders/$(incoming().lastOrderId))
          && existsAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId))
          && getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId)).data.userId == request.auth.uid) ||
        (isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'lastOrderId', 'updatedAt'])
          && incoming().stock > existing().stock
          && incoming().stock <= existing().stock + 50
          && ('lastOrderId' in incoming())
          && isValidId(incoming().lastOrderId)
          && exists(/databases/$(database)/documents/orders/$(incoming().lastOrderId))
          && get(/databases/$(database)/documents/orders/$(incoming().lastOrderId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(incoming().lastOrderId)).data.orderStatus in ['Order Placed', 'Confirmed', 'Processing']
          && existsAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId))
          && getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId)).data.orderStatus == 'Cancelled') ||
        (isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['ratingAvg', 'reviewCount', 'updatedAt'])
          && incoming().reviewCount >= existing().reviewCount
          && existsAfter(/databases/$(database)/documents/reviews/$(productId + '_' + request.auth.uid)))
      );
      allow delete: if isValidId(productId) && (isAdmin() || (isApprovedSeller() && existing().sellerId == request.auth.uid));
    }

    match /carts/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidCart(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /wishlists/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidWishlist(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /addresses/{addressId} {
      allow get: if isValidId(addressId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(addressId) && isValidAddress(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(addressId) && isValidAddress(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(addressId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming());
      allow update: if isValidId(couponId) && isValidCoupon(incoming()) && (
        isAdmin() ||
        (isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['usedCount'])
          && incoming().usedCount == existing().usedCount + 1
          && incoming().usedCount <= existing().usageLimit)
      );
      allow delete: if isAdmin() && isValidId(couponId);
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin() ||
        ('sellerIds' in existing() && existing().sellerIds is list && request.auth.uid in existing().sellerIds) ||
        ('assignedDriverId' in existing() && existing().assignedDriverId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        ('sellerIds' in resource.data && resource.data.sellerIds is list && request.auth.uid in resource.data.sellerIds) ||
        ('assignedDriverId' in resource.data && resource.data.assignedDriverId == request.auth.uid)
      );
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && (
          (incoming().paymentMethod == 'COD' && incoming().paymentStatus == 'Pending' && incoming().orderStatus == 'Confirmed') ||
          (incoming().paymentMethod != 'COD'
            && incoming().paymentStatus == 'Paid'
            && incoming().orderStatus == 'Confirmed'
            && ('razorpayOrderId' in incoming()) && incoming().razorpayOrderId.size() > 5
            && ('razorpayPaymentId' in incoming()) && incoming().razorpayPaymentId.size() > 5)
        );
      allow update: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid
          && existing().orderStatus in ['Order Placed', 'Confirmed', 'Processing']
          && incoming().orderStatus == 'Cancelled'
          && incoming().userId == existing().userId
          && incoming().pricing == existing().pricing
          && (
            (existing().paymentStatus == 'Paid'
              && incoming().get('refundStatus', 'None') == 'Initiated'
              && incoming().get('refundAmount', 0) >= 0
              && incoming().get('refundAmount', 0) <= existing().pricing.finalAmount) ||
            (existing().paymentStatus != 'Paid'
              && incoming().get('refundStatus', 'None') == existing().get('refundStatus', 'None'))
          )
          && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'statusHistory', 'refundStatus', 'refundAmount', 'refundNotes', 'updatedAt'])) ||
        (existing().userId == request.auth.uid
          && existing().orderStatus == 'Delivered'
          && incoming().orderStatus == 'Return Requested'
          && incoming().userId == existing().userId
          && incoming().pricing == existing().pricing
          && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'returnRequest', 'statusHistory', 'updatedAt'])) ||
        (isApprovedSeller()
          && ('sellerIds' in existing()) && existing().sellerIds is list && request.auth.uid in existing().sellerIds
          && incoming().userId == existing().userId
          && incoming().pricing == existing().pricing
          && (
            incoming().orderStatus in ['Accepted', 'Processing', 'Preparing', 'Packed', 'Ready for Pickup', 'Shipped'] ||
            (incoming().orderStatus == 'Cancelled' && existing().orderStatus in ['Order Placed', 'Confirmed', 'Accepted', 'Processing', 'Preparing'])
          )
          && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'statusHistory', 'updatedAt'])) ||
        (isApprovedDriver()
          && ('assignedDriverId' in existing()) && existing().assignedDriverId == request.auth.uid
          && existing().orderStatus in ['Confirmed', 'Accepted', 'Processing', 'Preparing', 'Packed', 'Ready for Pickup', 'Shipped', 'Out for Delivery']
          && incoming().userId == existing().userId
          && incoming().pricing == existing().pricing
          && (
            (incoming().orderStatus == 'Out for Delivery' && incoming().paymentStatus == existing().paymentStatus) ||
            (incoming().orderStatus == 'Delivered'
              && (incoming().paymentStatus == existing().paymentStatus || (existing().paymentMethod == 'COD' && incoming().paymentStatus == 'Paid')))
          )
          && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'paymentStatus', 'statusHistory', 'updatedAt']))
      );
      allow delete: if false;
    }

    match /orderItems/{itemId} {
      allow get: if isValidId(itemId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin() || ('sellerId' in existing() && existing().sellerId == request.auth.uid));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid));
      allow create: if isSignedIn() && isValidId(itemId) && isValidOrderItem(incoming())
        && incoming().userId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId));
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming())
        && incoming().userId == request.auth.uid
        && (
          (existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId))
            && incoming().status in ['Pending', 'Paid']
            && (incoming().status != 'Paid' || (incoming().method != 'COD' && ('razorpayPaymentId' in incoming()) && incoming().razorpayPaymentId.size() > 5))) ||
          (incoming().orderId == 'ATTEMPT'
            && incoming().status in ['Initiated', 'Pending', 'Failed', 'Cancelled']
            && incoming().get('gatewayVerified', false) == false)
        );
      allow update: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid
          && existing().orderId == 'ATTEMPT'
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().amount == existing().amount
          && (
            (incoming().orderId == 'ATTEMPT'
              && incoming().status in ['Failed', 'Cancelled']
              && incoming().get('gatewayVerified', false) == false) ||
            (existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId))
              && getAfter(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid
              && incoming().status in ['Pending', 'Paid']
              && (incoming().status != 'Paid' || (incoming().method != 'COD' && ('razorpayPaymentId' in incoming()) && incoming().razorpayPaymentId.size() > 5)))
          ))
      );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming())
        && incoming().userId == request.auth.uid
        && !('sellerReply' in incoming())
        && !('sellerReplyBy' in incoming())
        && !('sellerRepliedAt' in incoming())
        && exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid
          && incoming().userId == existing().userId
          && incoming().productId == existing().productId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'title', 'comment', 'images', 'sellerId', 'updatedAt'])) ||
        (isApprovedSeller()
          && get(/databases/$(database)/documents/products/$(existing().productId)).data.sellerId == request.auth.uid
          && incoming().userId == existing().userId
          && incoming().productId == existing().productId
          && incoming().rating == existing().rating
          && incoming().title == existing().title
          && incoming().comment == existing().comment
          && incoming().verifiedPurchase == existing().verifiedPurchase
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['sellerId', 'sellerReply', 'sellerReplyBy', 'sellerRepliedAt', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming())
        && (
          incoming().userId == request.auth.uid ||
          isAdmin() ||
          isApprovedDriver() ||
          isApprovedSeller() ||
          (('orderId' in incoming())
            && incoming().orderId is string
            && isValidId(incoming().orderId)
            && exists(/databases/$(database)/documents/orders/$(incoming().orderId))
            && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid
            && ('sellerIds' in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data)
            && incoming().userId in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.sellerIds)
        );
      allow update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming())
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(ticketId) && isValidSupportTicket(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Open'
        && !('adminReply' in incoming())
        && !('repliedBy' in incoming());
      allow update: if isAdmin() && isValidId(ticketId) && isValidSupportTicket(incoming());
      allow delete: if isAdmin() && isValidId(ticketId);
    }

    match /flashSales/{saleId} {
      allow get: if isValidId(saleId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(saleId) && isValidFlashSale(incoming());
      allow update: if isValidId(saleId) && isValidFlashSale(incoming()) && (
        isAdmin() ||
        (isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['soldCount', 'updatedAt'])
          && incoming().soldCount >= existing().soldCount
          && incoming().soldCount <= existing().soldCount + 20
          && incoming().soldCount <= existing().saleStock)
      );
      allow delete: if isAdmin() && isValidId(saleId);
    }

    match /rewards/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidRewardAccount(incoming()) && (
        isAdmin() ||
        (isOwner(userId) && incoming().userId == request.auth.uid && incoming().pointsBalance <= 500 && incoming().totalEarned <= 500)
      );
      allow update: if isValidId(userId) && isValidRewardAccount(incoming()) && (
        isAdmin() ||
        (isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().referralCode == existing().referralCode
          && incoming().totalEarned >= existing().totalEarned
          && incoming().totalEarned <= existing().totalEarned + 10000
          && incoming().totalRedeemed >= existing().totalRedeemed
          && incoming().pointsBalance <= existing().pointsBalance + (incoming().totalEarned - existing().totalEarned)
          && incoming().diff(existing()).affectedKeys().hasOnly(['pointsBalance', 'totalEarned', 'totalRedeemed', 'history', 'updatedAt']))
      );
      allow delete: if isValidId(userId) && (isAdmin() || isOwner(userId));
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(settingId) && isValidStoreSettings(incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    match /sellers/{sellerId} {
      allow get: if isValidId(sellerId) && (isOwner(sellerId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(sellerId) && isOwner(sellerId)
        && isValidSeller(incoming())
        && incoming().sellerId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().approvalStatus == 'Pending';
      allow update: if isValidId(sellerId) && isValidSeller(incoming()) && (
        isAdmin() ||
        (isOwner(sellerId)
          && incoming().sellerId == existing().sellerId
          && incoming().userId == existing().userId
          && incoming().commissionPercent == existing().commissionPercent
          && (
            incoming().approvalStatus == existing().approvalStatus ||
            (existing().approvalStatus == 'Rejected' && incoming().approvalStatus == 'Pending')
          )
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'businessName', 'ownerName', 'email', 'mobile',
            'shopCategory', 'shopPhone', 'description', 'logoUrl', 'coverImageUrl',
            'verificationDocs', 'gstin', 'cityId', 'serviceZones', 'wardNumbers',
            'operatingHours', 'pickupAddress', 'payoutUpiOrBank', 'approvalStatus', 'updatedAt'
          ]))
      );
      allow delete: if isAdmin() && isValidId(sellerId);
    }

    match /sellerSettlements/{settlementId} {
      allow get: if isValidId(settlementId) && isSignedIn() && (existing().sellerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(settlementId) && isValidSellerSettlement(incoming()) && (
        isAdmin() ||
        (incoming().status == 'Pending'
          && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId))
          && getAfter(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid)
      );
      allow update: if isValidId(settlementId) && isValidSellerSettlement(incoming()) && (
        isAdmin() ||
        (isApprovedSeller()
          && existing().sellerId == request.auth.uid
          && existing().status == 'Pending'
          && incoming().status == 'Cancelled'
          && incoming().sellerId == existing().sellerId
          && incoming().orderId == existing().orderId
          && incoming().grossAmount == existing().grossAmount
          && incoming().netPayoutAmount == existing().netPayoutAmount
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deductionReason', 'updatedAt'])
          && existsAfter(/databases/$(database)/documents/orders/$(existing().orderId))
          && getAfter(/databases/$(database)/documents/orders/$(existing().orderId)).data.orderStatus == 'Cancelled') ||
        (isSignedIn()
          && existing().status == 'Pending'
          && incoming().status == 'Cancelled'
          && incoming().sellerId == existing().sellerId
          && incoming().orderId == existing().orderId
          && incoming().grossAmount == existing().grossAmount
          && incoming().netPayoutAmount == existing().netPayoutAmount
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deductionReason', 'updatedAt'])
          && exists(/databases/$(database)/documents/orders/$(existing().orderId))
          && get(/databases/$(database)/documents/orders/$(existing().orderId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(existing().orderId)).data.orderStatus in ['Order Placed', 'Confirmed', 'Processing']
          && existsAfter(/databases/$(database)/documents/orders/$(existing().orderId))
          && getAfter(/databases/$(database)/documents/orders/$(existing().orderId)).data.orderStatus == 'Cancelled')
      );
      allow delete: if false;
    }

    match /deliveryPartners/{partnerId} {
      allow get: if isValidId(partnerId) && (isOwner(partnerId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(partnerId) && isOwner(partnerId)
        && isValidDeliveryPartner(incoming())
        && incoming().partnerId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().verificationStatus == 'Pending'
        && incoming().isOnline == false;
      allow update: if isValidId(partnerId) && isValidDeliveryPartner(incoming()) && (
        isAdmin() ||
        (isOwner(partnerId)
          && incoming().partnerId == existing().partnerId
          && incoming().userId == existing().userId
          && incoming().verificationStatus == existing().verificationStatus
          && (incoming().isOnline == false || existing().verificationStatus == 'Approved')
          && incoming().get('totalDeliveries', 0) >= existing().get('totalDeliveries', 0)
          && incoming().get('totalEarnings', 0) >= existing().get('totalEarnings', 0)
          && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'mobile', 'vehicleType', 'vehicleNumber', 'licenseNumber', 'cityId', 'city', 'state', 'assignedZones', 'isOnline', 'currentLat', 'currentLng', 'locationUpdatedAt', 'totalDeliveries', 'totalEarnings', 'updatedAt']))
      );
      allow delete: if isAdmin() && isValidId(partnerId);
    }

    match /deliveryAssignments/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        existing().driverId == request.auth.uid ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.driverId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin() && isValidId(orderId) && isValidDeliveryAssignment(incoming());
      allow update: if isValidId(orderId) && isValidDeliveryAssignment(incoming()) && (
        isAdmin() ||
        (isApprovedDriver()
          && existing().driverId == request.auth.uid
          && existing().status in ['Assigned', 'Accepted', 'Picked Up', 'Out for Delivery']
          && incoming().driverId == existing().driverId
          && incoming().orderId == existing().orderId
          && incoming().userId == existing().userId
          && incoming().otpHash == existing().otpHash
          && incoming().codAmountToCollect == existing().codAmountToCollect
          && incoming().deliveryFeeEarning == existing().deliveryFeeEarning
          && (
            incoming().status == existing().status ||
            (existing().status == 'Assigned' && incoming().status in ['Accepted', 'Rejected']) ||
            (existing().status == 'Accepted' && incoming().status in ['Picked Up', 'Out for Delivery']) ||
            (existing().status == 'Picked Up' && incoming().status == 'Out for Delivery') ||
            (existing().status == 'Out for Delivery' && incoming().status == 'Delivered')
          )
          && (incoming().status != 'Delivered' || (('otpSubmittedHash' in incoming()) && incoming().otpSubmittedHash == existing().otpHash))
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'otpSubmittedHash', 'driverLat', 'driverLng', 'driverLocationUpdatedAt', 'deliveredAt', 'updatedAt']))
      );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /orderSecrets/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(orderId)
        && incoming().keys().hasAll(['orderId', 'userId', 'deliveryOtp', 'createdAt'])
        && incoming().orderId == orderId;
      allow update, delete: if isAdmin() && isValidId(orderId);
    }

    match /serviceCities/{cityId} {
      allow get: if isValidId(cityId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(cityId) && isValidServiceCity(incoming());
      allow delete: if isAdmin() && isValidId(cityId);
    }

    match /serviceZones/{zoneId} {
      allow get: if isValidId(zoneId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(zoneId) && isValidServiceZone(incoming());
      allow delete: if isAdmin() && isValidId(zoneId);
    }

    match /serviceWards/{wardId} {
      allow get: if isValidId(wardId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(wardId) && isValidServiceWard(incoming());
      allow delete: if isAdmin() && isValidId(wardId);
    }

    match /publicShops/{shopId} {
      allow get: if isValidId(shopId);
      allow list: if true;
      allow create: if isValidId(shopId) && isValidPublicShop(incoming()) && (
        isAdmin() ||
        (isOwner(shopId) && incoming().shopId == request.auth.uid && (incoming().approvalStatus == 'Pending' || isApprovedSeller()))
      );
      allow update: if isValidId(shopId) && isValidPublicShop(incoming()) && (
        isAdmin() ||
        (isOwner(shopId)
          && incoming().shopId == existing().shopId
          && (
            incoming().approvalStatus == existing().approvalStatus ||
            (existing().approvalStatus == 'Rejected' && incoming().approvalStatus == 'Pending')
          ))
      );
      allow delete: if isAdmin() && isValidId(shopId);
    }

    match /publicDrivers/{partnerId} {
      allow get: if isValidId(partnerId);
      allow list: if true;
      allow create: if isValidId(partnerId) && isValidPublicDriver(incoming()) && (
        isAdmin() ||
        (isOwner(partnerId) && incoming().partnerId == request.auth.uid && ((incoming().verificationStatus == 'Pending' && incoming().isOnline == false) || isApprovedDriver()))
      );
      allow update: if isValidId(partnerId) && isValidPublicDriver(incoming()) && (
        isAdmin() ||
        (isOwner(partnerId)
          && incoming().partnerId == existing().partnerId
          && incoming().verificationStatus == existing().verificationStatus
          && (incoming().isOnline == false || existing().verificationStatus == 'Approved'))
      );
      allow delete: if isAdmin() && isValidId(partnerId);
    }
  }
}
