      "properties": {
        "earnPointsPer100": { "type": "number" },
        "rupeePerPoint": { "type": "number" },
        "maxRedeemPercent": { "type": "number" },
        "referralBonusPoints": { "type": "number" },
        "defaultSellerCommissionPercent": { "type": "number" },
        "promoBannerText": { "type": "string", "maxLength": 240 },
        "promoBannerActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["earnPointsPer100", "rupeePerPoint", "maxRedeemPercent", "referralBonusPoints", "defaultSellerCommissionPercent", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
