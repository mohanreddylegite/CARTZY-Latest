{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered CARTZY customer, seller, delivery partner, or store administrator profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "mobile": { "type": "string", "maxLength": 15 },
        "role": { "type": "string", "enum": ["customer", "admin", "seller", "delivery"] },
        "emailVerified": { "type": "boolean" },
        "phoneVerified": { "type": "boolean" },
        "onboardingCompleted": { "type": "boolean" },
        "privacySettings": { "type": "object" },
        "photoUrl": { "type": "string", "maxLength": 60000 },
        "defaultPincode": { "type": "string", "maxLength": 6 },
        "suspended": { "type": "boolean" },
        "suspensionReason": { "type": "string", "maxLength": 300 },
        "referralCode": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["uid", "fullName", "email", "role", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Authorized administrator role document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "grantedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product catalog category.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 40 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 300 },
        "displayOrder": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "slug", "displayOrder", "active"]
    },
    "Product": {
      "title": "Product",
      "description": "Storefront catalog product with pricing, stock, variants, seller info, and rating metrics.",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "minLength": 1, "maxLength": 60 },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 80 },
        "brand": { "type": "string", "maxLength": 80 },
        "images": { "type": "array" },
        "originalPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "stock": { "type": "number" },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "soldCount": { "type": "number" },
        "specifications": { "type": "object" },
        "availableSizes": { "type": "array" },
        "availableColors": { "type": "array" },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 120 },
        "cityId": { "type": "string", "maxLength": 64 },
        "serviceZones": { "type": "array" },
        "approvalStatus": { "type": "string", "enum": ["Approved", "Pending", "Rejected"] },
        "tags": { "type": "array" },
        "taxRatePercent": { "type": "number" },
        "active": { "type": "boolean" },
        "lastOrderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["sku", "name", "categoryId", "brand", "originalPrice", "sellingPrice", "stock", "active", "createdAt", "updatedAt"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Persistent shopping cart owned by a user.",
      "type": "object",
      "properties": {
        "items": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["items", "updatedAt"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "Saved wishlist product IDs owned by a user.",
      "type": "object",
      "properties": {
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["productIds", "updatedAt"]
    },
    "Address": {
      "title": "Address",
      "description": "Indian delivery address belonging to a customer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "enum": ["Home", "Work", "Other"] },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mobile": { "type": "string", "pattern": "^[6-9][0-9]{9}$" },
        "altMobile": { "type": "string", "maxLength": 10 },
        "houseNo": { "type": "string", "minLength": 1, "maxLength": 100 },
        "street": { "type": "string", "minLength": 1, "maxLength": 150 },
        "locality": { "type": "string", "minLength": 1, "maxLength": 150 },
        "landmark": { "type": "string", "maxLength": 150 },
        "city": { "type": "string", "minLength": 1, "maxLength": 100 },
        "district": { "type": "string", "minLength": 1, "maxLength": 100 },
        "state": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pincode": { "type": "string", "pattern": "^[1-9][0-9]{5}$" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "placeId": { "type": "string", "maxLength": 200 },
        "formattedAddress": { "type": "string", "maxLength": 400 },
        "zoneId": { "type": "string", "maxLength": 64 },
        "wardNumber": { "type": "number" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["userId", "label", "fullName", "mobile", "houseNo", "street", "locality", "city", "district", "state", "pincode", "isDefault", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 30 },
        "type": { "type": "string", "enum": ["PERCENT", "FIXED"] },
        "value": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "expiryDate": { "type": "string", "maxLength": 40 },
        "usageLimit": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "type", "value", "minOrderAmount", "maxDiscount", "expiryDate", "usageLimit", "usedCount", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with immutable pricing breakdown, delivery details, and status timeline.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "userId": { "type": "string", "maxLength": 128 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "customerInfo": { "type": "object" },
        "deliveryAddress": { "type": "object" },
        "serviceAreaMeta": { "type": "object" },
        "courierTracking": { "type": "object" },
        "deliveryOption": { "type": "string", "enum": ["STANDARD", "EXPRESS"] },
        "estimatedDeliveryText": { "type": "string", "maxLength": 150 },
        "pricing": { "type": "object" },
        "paymentMethod": { "type": "string", "enum": ["COD", "UPI", "CARD", "NETBANKING", "WALLET"] },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Initiated", "Paid", "Failed", "Cancelled", "Refunded"] },
        "refundStatus": { "type": "string", "enum": ["None", "Initiated", "Processed", "Failed"] },
        "refundAmount": { "type": "number" },
        "refundNotes": { "type": "string", "maxLength": 300 },
        "razorpayOrderId": { "type": "string", "maxLength": 120 },
        "razorpayPaymentId": { "type": "string", "maxLength": 120 },
        "orderStatus": { "type": "string", "enum": ["Order Placed", "Confirmed", "Accepted", "Processing", "Preparing", "Packed", "Ready for Pickup", "Shipped", "Out for Delivery", "Delivered", "Cancelled", "Return Requested", "Returned"] },
        "returnRequest": { "type": "object" },
        "sellerIds": { "type": "array" },
        "assignedDriverId": { "type": "string", "maxLength": 128 },
        "deliveryAssignmentId": { "type": "string", "maxLength": 128 },
        "statusHistory": { "type": "array" },
        "itemsCount": { "type": "number" },
        "itemsPreview": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "orderNumber", "userId", "idempotencyKey", "customerInfo", "deliveryAddress", "deliveryOption", "pricing", "paymentMethod", "paymentStatus", "orderStatus", "statusHistory", "itemsCount", "itemsPreview", "createdAt", "updatedAt"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Individual product line item linked to an order.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 60 },
        "name": { "type": "string", "maxLength": 180 },
        "image": { "type": "string", "maxLength": 500 },
        "unitOriginalPrice": { "type": "number" },
        "unitSellingPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "lineTotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "selectedSize": { "type": "string", "maxLength": 40 },
        "selectedColor": { "type": "string", "maxLength": 40 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["orderId", "userId", "productId", "name", "unitSellingPrice", "quantity", "lineTotal", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction and attempt audit record.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "method": { "type": "string", "enum": ["COD", "UPI", "CARD", "NETBANKING", "WALLET"] },
        "razorpayOrderId": { "type": "string", "maxLength": 120 },
        "razorpayPaymentId": { "type": "string", "maxLength": 120 },
        "razorpayRefundId": { "type": "string", "maxLength": 120 },
        "gatewayVerified": { "type": "boolean" },
        "failureReason": { "type": "string", "maxLength": 300 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["Pending", "Initiated", "Paid", "Failed", "Cancelled", "Refunded"] },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["orderId", "orderNumber", "userId", "method", "amount", "currency", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer rating and review for a purchased product.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 260 },
        "productId": { "type": "string", "maxLength": 128 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 120 },
        "comment": { "type": "string", "maxLength": 1000 },
        "images": { "type": "array" },
        "verifiedPurchase": { "type": "boolean" },
        "sellerReply": { "type": "string", "maxLength": 800 },
        "sellerReplyBy": { "type": "string", "maxLength": 120 },
        "sellerRepliedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "title", "comment", "verifiedPurchase", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app order and account notification.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 140 },
        "message": { "type": "string", "maxLength": 500 },
        "orderId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer and seller help and order support request.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "enum": ["customer", "seller", "delivery"] },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 160 },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "topic": { "type": "string", "maxLength": 80 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved"] },
        "adminReply": { "type": "string", "maxLength": 1500 },
        "repliedBy": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["userId", "name", "email", "topic", "message", "status", "createdAt"]
    },
    "FlashSale": {
      "title": "FlashSale",
      "description": "Time-limited promotional flash sale offer tied to a catalog product.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productName": { "type": "string", "minLength": 1, "maxLength": 180 },
        "productImage": { "type": "string", "maxLength": 500 },
        "brand": { "type": "string", "maxLength": 80 },
        "categoryName": { "type": "string", "maxLength": 80 },
        "originalPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "saleStock": { "type": "number" },
        "soldCount": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 40 },
        "endDate": { "type": "string", "maxLength": 40 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["title", "productId", "productName", "originalPrice", "salePrice", "discountPercent", "saleStock", "soldCount", "startDate", "endDate", "active", "createdAt", "updatedAt"]
    },
    "RewardAccount": {
