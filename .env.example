# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY CREDENTIALS (Server-Side Only for Secrets; Public Key ID for Checkout Modal)
# Configure these in AI Studio Secrets or your server environment to enable live UPI/Cards/NetBanking
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
VITE_RAZORPAY_KEY_ID=""

# OPTIONAL SMTP EMAIL CREDENTIALS (Leave empty if not yet configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CARTZY <no-reply@cartzy.in>"

# OPTIONAL FIREBASE ADMIN SERVICE ACCOUNT JSON (for privileged server-side writes)
FIREBASE_SERVICE_ACCOUNT_KEY=""

# GOOGLE MAPS PLATFORM (Restrict browser key to HTTP referrers + Maps JavaScript API & Places API (New))
VITE_GOOGLE_MAPS_API_KEY=""
# Optional separate server-restricted key for Geocoding API reverse-geocoding proxy (never exposed to browser)
GOOGLE_MAPS_SERVER_KEY=""
